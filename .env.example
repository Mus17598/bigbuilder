# Deployed origin, no trailing slash.
# Drives metadataBase, Open Graph, JSON-LD, robots.txt and sitemap.xml.
# Absolute URLs in the OG tags are wrong until this is set.
NEXT_PUBLIC_SITE_URL=https://bigbuilder.example

# Where the contact form POSTs its JSON payload.
# Leave unset to run the form in acknowledge-and-log mode.
NEXT_PUBLIC_FORM_ENDPOINT=
